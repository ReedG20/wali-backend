{
  "name": "mind-backend",
  "version": "1.0.0",
  "description": "Convex backend for the Mind pendant",
  "scripts": {
    "dev": "convex dev",
    "deploy": "convex deploy -y",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc -p convex --noEmit",
    "test:audio": "bash scripts/make-test-audio.sh",
    "test:e2e": "node scripts/test-pipeline.ts scripts/out/two-speakers.wav",
    "api-spec": "convex-helpers ts-api-spec --output-file ../web/apps/app/lib/convex-api"
  },
  "type": "module",
  "dependencies": {
    "@composio/core": "^0.29.0",
    "@mastra/core": "^1.83.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@supermemory/tools": "^3.1.3",
    "ai": "^7.0.173",
    "convex": "^1.50.0",
    "supermemory": "^5.1.2",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/web-push": "^3.6.4",
    "convex-helpers": "^0.1.135",
    "typescript": "^7.0.2"
  },
  "private": true
}
